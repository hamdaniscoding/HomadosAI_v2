# HOMADOS AI / VoiceGuardAI environment
# Copy to .env and adjust. Never commit real secrets.

APP_ENV=development

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=*

# Audio processing
WINDOW_SECONDS=5.0
HOP_SECONDS=1.0
SAMPLE_RATE=16000
MAX_SESSION_SECONDS=3600
MAX_FRAME_BYTES=64000

# Model loading (requires requirements-ml.txt)
TORCH_DEVICE=cpu
ECAPA_SOURCE=speechbrain/spkrec-ecapa-voxceleb
ECAPA_SAVEDIR=models/ecapa_tdnn
